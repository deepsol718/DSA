2. Next permutation (https://leetcode.com/problems/next-permutation/)

class Solution {
    public void nextPermutation(int[] nums) {
        // 10 23 45 12 2 45 5 2 3 2 4 2 3 1
    
        
        int index = -1;
        //if index remains -1 it means that it is in descending order we have to reverse the array
        
        for ( int i = nums.length-1; i>0; i--){
            //here checking for a break point from back where array will stop ascending 
            if (nums[i] > nums[i-1]){
                index = i - 1;
            
                for (int j = nums.length -1; j > index; j--){
                    //here checking the array[i] where it will be greater than the array[i] at breaking point
                    //and swapping those values
                    if (nums[j] > nums[index]){
                        int temp = nums[j];
                        nums[j] = nums[index];
                        nums[index] =  temp;
                        //System.out.println("nums[j]: "+ nums[j] + "nums[index] :"+nums[index]);
                        break;
                    }
                }
                break;
            }
        }
        
        //here reversing the array after the break point 
        for (int i=0; i < (nums.length - index  )/2; i++){
                int temp = nums[index + i + 1];
                nums[i + index + 1] = nums[nums.length - i -1];
                nums[nums.length - i -1] = temp;
            }
        
       
    }
}

